# Copy to .env for local development.

# SQLAlchemy URL for the primary PostgreSQL database.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sprintops

# Used only by the test suite (tests/conftest.py). Defaults to a local
# container on port 55432 if unset.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55432/sot_test
